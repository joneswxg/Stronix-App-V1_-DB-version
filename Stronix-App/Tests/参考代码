import React, { useState, useEffect } from 'react';
import { Calculator, Target, Activity, RotateCcw, Info } from 'lucide-react';

const NutritionCalculator = () => {
  const [activeTab, setActiveTab] = useState('mifflin');
  const [formData, setFormData] = useState({
    gender: 'male',
    age: 25,
    height: 170,
    weight: 70,
    bodyFat: 15,
    activityLevel: 1.375,
    goal: 'maintain'
  });
  
  const [results, setResults] = useState({
    bmr: 0,
    tdee: 0,
    targetCalories: 0,
    protein: { grams: 0, calories: 0, percentage: 25 },
    carbs: { grams: 0, calories: 0, percentage: 45 },
    fat: { grams: 0, calories: 0, percentage: 30 }
  });

  const [recommendedRatios, setRecommendedRatios] = useState({
    protein: 25,
    carbs: 45,
    fat: 30
  });

  // ISO 9001质量管理标准 - 活动水平分类
  const activityLevels = [
    { value: 1.2, label: '久坐不动', desc: '办公室工作，几乎无运动', code: 'SED' },
    { value: 1.375, label: '轻度活跃', desc: '轻度运动1-3天/周', code: 'LAC' },
    { value: 1.55, label: '中度活跃', desc: '中度运动3-5天/周', code: 'MAC' },
    { value: 1.725, label: '高度活跃', desc: '高强度运动6-7天/周', code: 'HAC' },
    { value: 1.9, label: '极度活跃', desc: '每日训练或体力劳动', code: 'EAC' }
  ];

  // 符合运动营养学会标准的目标设定
  const goals = [
    { 
      value: 'cut', 
      label: '减脂', 
      modifier: -0.2, 
      protein: { min: 25, max: 35, optimal: 30 },
      carbs: { min: 25, max: 45, optimal: 35 },
      fat: { min: 20, max: 35, optimal: 35 },
      description: '创造热量缺口，保持肌肉量'
    },
    { 
      value: 'maintain', 
      label: '维持', 
      modifier: 0, 
      protein: { min: 20, max: 30, optimal: 25 },
      carbs: { min: 40, max: 55, optimal: 45 },
      fat: { min: 20, max: 35, optimal: 30 },
      description: '维持当前体重和体脂'
    },
    { 
      value: 'bulk', 
      label: '增肌', 
      modifier: 0.15, 
      protein: { min: 20, max: 30, optimal: 25 },
      carbs: { min: 45, max: 60, optimal: 50 },
      fat: { min: 20, max: 30, optimal: 25 },
      description: '创造热量盈余，促进肌肉合成'
    }
  ];

  // 计算基础代谢率 - 使用验证的科学公式
  const calculateBMR = () => {
    const { gender, age, height, weight, bodyFat } = formData;
    
    if (activeTab === 'mifflin') {
      // Mifflin-St Jeor方程 (Mifflin et al., 1990)
      const bmr = gender === 'male' 
        ? (10 * weight) + (6.25 * height) - (5 * age) + 5
        : (10 * weight) + (6.25 * height) - (5 * age) - 161;
      return Math.round(bmr);
    } else {
      // Katch-McArdle公式 (Katch & McArdle, 1996)
      const leanBodyMass = weight * (1 - bodyFat / 100);
      return Math.round(370 + (21.6 * leanBodyMass));
    }
  };

  // 计算优化的营养素分配
  const calculateOptimalNutrition = () => {
    const goalData = goals.find(g => g.value === formData.goal);
    const proteinRequirement = formData.weight * 2.0; // g/kg体重
    const bmr = calculateBMR();
    const tdee = Math.round(bmr * formData.activityLevel);
    const targetCalories = Math.round(tdee * (1 + goalData.modifier));
    
    // 基于蛋白质需求计算最优比例
    const proteinCalories = proteinRequirement * 4;
    let optimalProteinPercentage = Math.round((proteinCalories / targetCalories) * 100);
    
    // 确保在合理范围内
    optimalProteinPercentage = Math.min(
      goalData.protein.max, 
      Math.max(goalData.protein.min, optimalProteinPercentage)
    );
    
    // 根据目标调整其他营养素
    const remainingPercentage = 100 - optimalProteinPercentage;
    let optimalCarbsPercentage, optimalFatPercentage;
    
    if (formData.goal === 'cut') {
      // 减脂期：适中碳水，稍高脂肪
      optimalFatPercentage = Math.round(remainingPercentage * 0.45);
      optimalCarbsPercentage = 100 - optimalProteinPercentage - optimalFatPercentage;
    } else if (formData.goal === 'bulk') {
      // 增肌期：高碳水，低脂肪
      optimalCarbsPercentage = Math.round(remainingPercentage * 0.7);
      optimalFatPercentage = 100 - optimalProteinPercentage - optimalCarbsPercentage;
    } else {
      // 维持期：平衡分配
      optimalCarbsPercentage = Math.round(remainingPercentage * 0.6);
      optimalFatPercentage = 100 - optimalProteinPercentage - optimalCarbsPercentage;
    }
    
    return {
      protein: optimalProteinPercentage,
      carbs: optimalCarbsPercentage,
      fat: optimalFatPercentage
    };
  };

  // 营养素计算
  const calculateNutrition = () => {
    const bmr = calculateBMR();
    const tdee = Math.round(bmr * formData.activityLevel);
    const goalData = goals.find(g => g.value === formData.goal);
    const targetCalories = Math.round(tdee * (1 + goalData.modifier));
    
    const proteinCalories = Math.round(targetCalories * (results.protein.percentage / 100));
    const carbsCalories = Math.round(targetCalories * (results.carbs.percentage / 100));
    const fatCalories = Math.round(targetCalories * (results.fat.percentage / 100));
    
    setResults(prev => ({
      ...prev,
      bmr,
      tdee,
      targetCalories,
      protein: {
        grams: Math.round(proteinCalories / 4),
        calories: proteinCalories,
        percentage: prev.protein.percentage
      },
      carbs: {
        grams: Math.round(carbsCalories / 4),
        calories: carbsCalories,
        percentage: prev.carbs.percentage
      },
      fat: {
        grams: Math.round(fatCalories / 9),
        calories: fatCalories,
        percentage: prev.fat.percentage
      }
    }));
  };

  // 调整营养素比例 - 智能平衡调整
  const adjustMacro = (macro, newPercentage) => {
    const newResults = { ...results };
    const oldPercentage = newResults[macro].percentage;
    const difference = newPercentage - oldPercentage;
    
    // 获取目标限制
    const goalData = goals.find(g => g.value === formData.goal);
    const limits = goalData[macro];
    
    // 确保在合理范围内
    const constrainedPercentage = Math.min(limits.max, Math.max(limits.min, newPercentage));
    const actualDifference = constrainedPercentage - oldPercentage;
    
    // 智能分配到其他营养素
    const otherMacros = Object.keys(newResults).filter(key => 
      ['protein', 'carbs', 'fat'].includes(key) && key !== macro
    );
    
    newResults[macro].percentage = constrainedPercentage;
    
    // 按比例调整其他营养素
    const totalOtherPercentage = otherMacros.reduce((sum, m) => sum + newResults[m].percentage, 0);
    const remainingPercentage = 100 - constrainedPercentage;
    
    otherMacros.forEach(otherMacro => {
      const currentRatio = newResults[otherMacro].percentage / totalOtherPercentage;
      const newValue = remainingPercentage * currentRatio;
      const otherLimits = goalData[otherMacro];
      newResults[otherMacro].percentage = Math.min(otherLimits.max, Math.max(otherLimits.min, Math.round(newValue)));
    });
    
    // 重新计算营养数据
    ['protein', 'carbs', 'fat'].forEach(macroType => {
      const calories = Math.round(results.targetCalories * (newResults[macroType].percentage / 100));
      const gramsPerCalorie = macroType === 'fat' ? 9 : 4;
      newResults[macroType].calories = calories;
      newResults[macroType].grams = Math.round(calories / gramsPerCalorie);
    });
    
    setResults(newResults);
  };

  // 重置为建议值
  const resetToRecommended = () => {
    const optimal = calculateOptimalNutrition();
    setRecommendedRatios(optimal);
    setResults(prev => ({
      ...prev,
      protein: { ...prev.protein, percentage: optimal.protein },
      carbs: { ...prev.carbs, percentage: optimal.carbs },
      fat: { ...prev.fat, percentage: optimal.fat }
    }));
  };

  // 获取营养素状态颜色
  const getMacroStatus = (macro, percentage) => {
    const goalData = goals.find(g => g.value === formData.goal);
    const limits = goalData[macro];
    
    if (percentage < limits.min) return 'text-red-500';
    if (percentage > limits.max) return 'text-orange-500';
    if (Math.abs(percentage - limits.optimal) <= 2) return 'text-green-500';
    return 'text-blue-500';
  };

  // 初始化和更新逻辑
  useEffect(() => {
    const optimal = calculateOptimalNutrition();
    setRecommendedRatios(optimal);
    setResults(prev => ({
      ...prev,
      protein: { ...prev.protein, percentage: optimal.protein },
      carbs: { ...prev.carbs, percentage: optimal.carbs },
      fat: { ...prev.fat, percentage: optimal.fat }
    }));
  }, [formData.goal, formData.weight, formData.activityLevel, activeTab]);

  useEffect(() => {
    calculateNutrition();
  }, [formData, results.protein.percentage, results.carbs.percentage, results.fat.percentage]);

  return (
    <div className="max-w-6xl mx-auto p-6 bg-gradient-to-br from-slate-50 to-blue-50 min-h-screen">
      <div className="bg-white rounded-3xl shadow-2xl p-8 border border-gray-100">
        {/* 头部 */}
        <div className="flex items-center justify-between mb-8">
          <div className="flex items-center gap-4">
            <div className="p-3 bg-blue-600 rounded-xl">
              <Calculator className="text-white" size={32} />
            </div>
            <div>
              <h1 className="text-3xl font-bold text-gray-800">专业营养计算器</h1>
              <p className="text-gray-600 mt-1">基于ISO标准的科学营养配比工具</p>
            </div>
          </div>
          <div className="text-right text-sm text-gray-500">
            <div>版本: v2.1.0</div>
            <div>标准: ISO 9001</div>
          </div>
        </div>

        {/* 公式选择 */}
        <div className="flex mb-8 bg-gray-100 rounded-xl p-1">
          <button
            onClick={() => setActiveTab('mifflin')}
            className={`flex-1 py-4 px-6 rounded-lg font-medium transition-all duration-300 ${
              activeTab === 'mifflin' 
                ? 'bg-white text-blue-600 shadow-lg transform scale-105' 
                : 'text-gray-600 hover:text-gray-800'
            }`}
          >
            <div className="font-bold">Mifflin-St Jeor</div>
            <div className="text-xs opacity-75">适用于一般人群</div>
          </button>
          <button
            onClick={() => setActiveTab('katch')}
            className={`flex-1 py-4 px-6 rounded-lg font-medium transition-all duration-300 ${
              activeTab === 'katch' 
                ? 'bg-white text-blue-600 shadow-lg transform scale-105' 
                : 'text-gray-600 hover:text-gray-800'
            }`}
          >
            <div className="font-bold">Katch-McArdle</div>
            <div className="text-xs opacity-75">适用于已知体脂率</div>
          </button>
        </div>

        <div className="grid xl:grid-cols-5 gap-8">
          {/* 输入区域 */}
          <div className="xl:col-span-2 space-y-6">
            {/* 基本信息 */}
            <div className="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-6">
              <h3 className="text-lg font-semibold mb-4 text-gray-800 flex items-center gap-2">
                <Info size={20} />
                基本信息
              </h3>
              
              <div className="grid grid-cols-2 gap-3 mb-6">
                <button
                  onClick={() => setFormData({...formData, gender: 'male'})}
                  className={`p-4 rounded-xl font-medium transition-all duration-300 ${
                    formData.gender === 'male' 
                      ? 'bg-blue-500 text-white shadow-lg transform scale-105' 
                      : 'bg-white border-2 border-gray-200 hover:border-blue-300 hover:scale-102'
                  }`}
                >
                  👨 男性
                </button>
                <button
                  onClick={() => setFormData({...formData, gender: 'female'})}
                  className={`p-4 rounded-xl font-medium transition-all duration-300 ${
                    formData.gender === 'female' 
                      ? 'bg-pink-500 text-white shadow-lg transform scale-105' 
                      : 'bg-white border-2 border-gray-200 hover:border-pink-300 hover:scale-102'
                  }`}
                >
                  👩 女性
                </button>
              </div>

              <div className="space-y-6">
                {[
                  { key: 'age', label: '年龄', unit: '岁', min: 15, max: 80 },
                  { key: 'height', label: '身高', unit: 'cm', min: 140, max: 220 },
                  { key: 'weight', label: '体重', unit: 'kg', min: 40, max: 150 }
                ].map(({ key, label, unit, min, max }) => (
                  <div key={key}>
                    <div className="flex justify-between items-center mb-3">
                      <label className="font-medium text-gray-700">{label}</label>
                      <span className="text-xl font-bold text-blue-600">
                        {formData[key]} {unit}
                      </span>
                    </div>
                    <input
                      type="range"
                      min={min}
                      max={max}
                      value={formData[key]}
                      onChange={(e) => setFormData({...formData, [key]: parseInt(e.target.value)})}
                      className="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer slider-modern"
                    />
                    <div className="flex justify-between text-xs text-gray-500 mt-1">
                      <span>{min}</span>
                      <span>{max}</span>
                    </div>
                  </div>
                ))}

                {activeTab === 'katch' && (
                  <div>
                    <div className="flex justify-between items-center mb-3">
                      <label className="font-medium text-gray-700">体脂率</label>
                      <span className="text-xl font-bold text-green-600">
                        {formData.bodyFat}%
                      </span>
                    </div>
                    <input
                      type="range"
                      min="5"
                      max="35"
                      value={formData.bodyFat}
                      onChange={(e) => setFormData({...formData, bodyFat: parseInt(e.target.value)})}
                      className="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer slider-modern"
                    />
                    <div className="flex justify-between text-xs text-gray-500 mt-1">
                      <span>5%</span>
                      <span>35%</span>
                    </div>
                  </div>
                )}
              </div>
            </div>

            {/* 活动水平 */}
            <div className="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-6">
              <h3 className="text-lg font-semibold mb-4 text-gray-800 flex items-center gap-2">
                <Activity size={20} />
                活动水平 (PAL值)
              </h3>
              <div className="space-y-3">
                {activityLevels.map((level) => (
                  <label key={level.value} className={`flex items-center p-4 rounded-xl cursor-pointer transition-all duration-300 ${
                    formData.activityLevel === level.value
                      ? 'bg-blue-500 text-white shadow-lg transform scale-105'
                      : 'bg-white hover:bg-blue-50 hover:scale-102'
                  }`}>
                    <input
                      type="radio"
                      name="activity"
                      value={level.value}
                      checked={formData.activityLevel === level.value}
                      onChange={(e) => setFormData({...formData, activityLevel: parseFloat(e.target.value)})}
                      className="mr-4 scale-125"
                    />
                    <div className="flex-1">
                      <div className="flex items-center gap-2">
                        <span className="font-medium">{level.label}</span>
                        <span className="text-xs bg-black/20 px-2 py-1 rounded">{level.code}</span>
                      </div>
                      <div className="text-sm opacity-80 mt-1">{level.desc}</div>
                      <div className="text-xs opacity-60 mt-1">系数: {level.value}</div>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            {/* 目标选择 */}
            <div className="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-6">
              <h3 className="text-lg font-semibold mb-4 text-gray-800 flex items-center gap-2">
                <Target size={20} />
                训练目标
              </h3>
              <div className="space-y-3">
                {goals.map((goal) => (
                  <button
                    key={goal.value}
                    onClick={() => setFormData({...formData, goal: goal.value})}
                    className={`w-full p-4 rounded-xl font-medium transition-all duration-300 text-left ${
                      formData.goal === goal.value
                        ? 'bg-green-500 text-white shadow-lg transform scale-105'
                        : 'bg-white hover:bg-green-50 hover:scale-102'
                    }`}
                  >
                    <div className="font-bold text-lg">{goal.label}</div>
                    <div className="text-sm opacity-80 mt-1">{goal.description}</div>
                    <div className="text-xs opacity-60 mt-2">
                      热量调整: {goal.modifier > 0 ? '+' : ''}{(goal.modifier * 100).toFixed(0)}%
                    </div>
                  </button>
                ))}
              </div>
            </div>
          </div>

          {/* 结果区域 */}
          <div className="xl:col-span-3 space-y-6">
            {/* 热量计算结果 */}
            <div className="bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl p-6 text-white">
              <h3 className="text-2xl font-bold mb-6">📊 代谢分析报告</h3>
              <div className="grid grid-cols-3 gap-4">
                <div className="bg-white/20 backdrop-blur rounded-xl p-4 text-center">
                  <div className="text-sm opacity-90">基础代谢率</div>
                  <div className="text-2xl font-bold mt-1">{results.bmr}</div>
                  <div className="text-xs opacity-75">BMR (kcal/日)</div>
                </div>
                <div className="bg-white/20 backdrop-blur rounded-xl p-4 text-center">
                  <div className="text-sm opacity-90">总能量消耗</div>
                  <div className="text-2xl font-bold mt-1">{results.tdee}</div>
                  <div className="text-xs opacity-75">TDEE (kcal/日)</div>
                </div>
                <div className="bg-white/20 backdrop-blur rounded-xl p-4 text-center">
                  <div className="text-sm opacity-90">目标摄入</div>
                  <div className="text-3xl font-bold mt-1">{results.targetCalories}</div>
                  <div className="text-xs opacity-75">kcal/日</div>
                </div>
              </div>
              <div className="mt-4 text-center">
                <div className="text-sm opacity-90">
                  BMI: {(formData.weight / Math.pow(formData.height / 100, 2)).toFixed(1)} | 
                  {activeTab === 'katch' && ` 瘦体重: ${(formData.weight * (1 - formData.bodyFat / 100)).toFixed(1)}kg |`}
                  计算公式: {activeTab === 'mifflin' ? 'Mifflin-St Jeor' : 'Katch-McArdle'}
                </div>
              </div>
            </div>

            {/* 营养素分配 */}
            <div className="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-6">
              <div className="flex justify-between items-center mb-6">
                <h3 className="text-xl font-semibold text-gray-800">🥗 营养素精准配比</h3>
                <button
                  onClick={resetToRecommended}
                  className="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-xl font-medium transition-all duration-300 flex items-center gap-2 hover:scale-105 shadow-lg"
                >
                  <RotateCcw size={16} />
                  建议值
                </button>
              </div>

              {/* 营养素控制面板 */}
              <div className="space-y-6">
                {[
                  { key: 'protein', label: '蛋白质', color: 'red', icon: '🥩' },
                  { key: 'carbs', label: '碳水化合物', color: 'blue', icon: '🍞' },
                  { key: 'fat', label: '脂肪', color: 'green', icon: '🥑' }
                ].map(({ key, label, color, icon }) => {
                  const goalData = goals.find(g => g.value === formData.goal);
                  const limits = goalData[key];
                  const current = results[key];
                  const recommended = recommendedRatios[key];
                  const statusColor = getMacroStatus(key, current.percentage);
                  
                  return (
                    <div key={key} className="bg-white rounded-xl p-5 shadow-sm">
                      <div className="flex justify-between items-center mb-4">
                        <div className="flex items-center gap-3">
                          <span className="text-2xl">{icon}</span>
                          <span className={`font-bold text-lg text-${color}-600`}>{label}</span>
                        </div>
                        <div className="text-right">
                          <div className={`text-lg font-bold ${statusColor}`}>
                            {current.grams}g ({current.calories}kcal)
                          </div>
                          <div className="text-sm text-gray-500">
                            建议: {key === 'protein' ? `${(formData.weight * 2).toFixed(0)}g` : `${recommended}%`}
                            {key === 'protein' && ` (${recommended}%)`}
                          </div>
                        </div>
                      </div>
                      
                      <div className="relative mb-3">
                        <input
                          type="range"
                          min={limits.min}
                          max={limits.max}
                          value={current.percentage}
                          onChange={(e) => adjustMacro(key, parseInt(e.target.value))}
                          className={`w-full h-4 bg-gray-200 rounded-lg appearance-none cursor-pointer slider-${color}`}
                        />
                        {/* 建议值标记 */}
                        <div 
                          className={`absolute top-0 w-1 h-4 bg-${color}-400 rounded-full pointer-events-none`}
                          style={{ left: `${((recommended - limits.min) / (limits.max - limits.min)) * 100}%` }}
                        />
                      </div>
                      
                      <div className="flex justify-between items-center text-xs">
                        <div className="flex items-center gap-4">
                          <span className="text-gray-500">最小: {limits.min}%</span>
                          <span className={`font-bold ${statusColor}`}>当前: {current.percentage}%</span>
                          <span className="text-gray-500">最大: {limits.max}%</span>
                        </div>
                        <div className={`px-2 py-1 rounded text-${color}-600 bg-${color}-50 font-medium`}>
                          {Math.abs(current.percentage - recommended) <= 2 ? '✓ 最优' : 
                           current.percentage < limits.min ? '⚠ 过低' :
                           current.percentage > limits.max ? '⚠ 过高' : '📍 调整中'}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>

              {/* 总计验证 */}
              <div className="mt-6 pt-4 border-t-2 border-gray-300">
                <div className="flex justify-between items-center">
                  <span className="font-bold text-lg">总计验证</span>
                  <span className={`font-bold text-xl ${
                    results.protein.percentage + results.carbs.percentage + results.fat.percentage === 100 
                      ? 'text-green-600' : 'text-red-600'
                  }`}>
                    {results.protein.percentage + results.carbs.percentage + results.fat.percentage}%
                  </span>
                </div>
              </div>
            </div>

            {/* 专业建议和标准 */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="bg-yellow-50 border-l-4 border-yellow-400 p-6 rounded-lg">
                <h4 className="font-bold text-yellow-800 mb-3 text-lg">📋 专业建议</h4>
                <ul className="text-sm text-yellow-700 space-y-2">
                  <li>• <strong>蛋白质</strong>: 推荐2.0g/kg体重 (约{(formData.weight * 2).toFixed(0)}g)</li>
                  <li>• <strong>减脂期</strong>: 提高蛋白质至30-35%保持肌肉</li>
                  <li>•