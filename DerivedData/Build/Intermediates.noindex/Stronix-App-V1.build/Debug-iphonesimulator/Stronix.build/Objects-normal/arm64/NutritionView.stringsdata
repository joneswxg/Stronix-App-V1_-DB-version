        }
      },
      {
        "comment": "",
        "key": "目标热量说明",
        "location": {
          "startingColumn": 58,
          "startingLine": 346
        }
      },
      {
        "comment": "",
        "key": "关闭",
        "location": {
          "startingColumn": 78,
